.DS_Store

# generated: UI capture output (npm run screenshots), ~10MB/run.
# Only the current prototype's captures are tracked; superseded runs are not,
# to keep them out of every future clone.
working_prototype_screenshots/*
!working_prototype_screenshots/v3/

